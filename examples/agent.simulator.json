{
  "device_id": "demo-1",
  "compatible": "qemu-demo",
  "state_dir": "/tmp/zyvor-ota-demo",
  "socket": "/tmp/zyvor-ota-demo/agent.sock",
  "backend": "simulator",
  "allow_device_writes": false,
  "trust_keys": {
    "demo": "REPLACE_WITH_GENERATED_PUBLIC_KEY"
  },
  "download_hosts": [
    "127.0.0.1:8080"
  ],
  "max_artifact_bytes": 4294967296,
  "reserve_bytes": 268435456,
  "health_timeout_seconds": 30,
  "health_stable_seconds": 2,
  "checks": [
    {
      "kind": "file",
      "target": "/etc/os-release"
    }
  ]
}
