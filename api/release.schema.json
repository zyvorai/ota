{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zyvor.dev/ota/release.schema.json",
  "title": "Zyvor OTA signed release payload",
  "oneOf": [
    { "$ref": "#/$defs/schema1" },
    { "$ref": "#/$defs/schema2" }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "size", "sha256"],
      "properties": {
        "url": { "type": "string", "format": "uri", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1, "maximum": 1099511627776 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
    },
    "schema1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "sequence", "compatible", "backend", "version", "expires", "artifact"],
      "properties": {
        "schema": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "compatible": { "type": "string", "minLength": 1 },
        "backend": { "enum": ["rauc", "simulator"] },
        "version": { "$ref": "#/$defs/id" },
        "expires": { "type": "string", "format": "date-time" },
        "sbom_sha256": { "type": "string", "pattern": "^([a-f0-9]{64})?$" },
        "sbom": { "$ref": "#/$defs/artifact" },
        "adaptive": { "type": "boolean" },
        "requires_measured_boot": { "type": "boolean" },
        "sbom_key_id": { "$ref": "#/$defs/id" },
        "sbom_signature": { "type": "string", "minLength": 1 },
        "artifact": { "$ref": "#/$defs/artifact" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "sbom_sha256": { "pattern": "^[a-f0-9]{64}$" } },
            "required": ["sbom_sha256"]
          },
          "then": { "required": ["sbom"] }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "artifact"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["os.rauc", "container.oci", "config.bundle", "model.oci"] },
        "artifact": { "$ref": "#/$defs/artifact" },
        "reboot": { "enum": ["required", "none"] },
        "health": { "type": "string", "minLength": 1 },
        "requires": { "$ref": "#/$defs/id" },
        "depends_on": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "rollback": { "enum": ["previous-digest", "slot"] },
        "storage_bytes": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "os.rauc" } },
            "required": ["type"]
          },
          "then": {
            "required": ["reboot"],
            "properties": { "reboot": { "const": "required" } }
          }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["container.oci", "config.bundle", "model.oci"] } },
            "required": ["type"]
          },
          "then": {
            "properties": { "reboot": { "const": "none" } }
          }
        }
      ]
    },
    "schema2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "sequence", "compatible", "backend", "version", "expires", "targets"],
      "properties": {
        "schema": { "const": 2 },
        "id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "compatible": { "type": "string", "minLength": 1 },
        "backend": { "enum": ["rauc", "simulator"] },
        "version": { "$ref": "#/$defs/id" },
        "expires": { "type": "string", "format": "date-time" },
        "sbom_sha256": { "type": "string", "pattern": "^([a-f0-9]{64})?$" },
        "sbom": { "$ref": "#/$defs/artifact" },
        "adaptive": { "type": "boolean" },
        "requires_measured_boot": { "type": "boolean" },
        "sbom_key_id": { "$ref": "#/$defs/id" },
        "sbom_signature": { "type": "string", "minLength": 1 },
        "artifact": { "$ref": "#/$defs/artifact" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/target" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "sbom_sha256": { "pattern": "^[a-f0-9]{64}$" } },
            "required": ["sbom_sha256"]
          },
          "then": { "required": ["sbom"] }
        }
      ]
    }
  }
}
