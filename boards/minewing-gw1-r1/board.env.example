# Copy to board.env and replace with PARTUUIDs from the BSP image layout.
# Do not commit real factory PARTUUIDs if they are deployment secrets.

ROOTFS_A=00000000-0000-4000-8000-0000000000a1
ROOTFS_B=00000000-0000-4000-8000-0000000000b1
BOOT_A=00000000-0000-4000-8000-0000000000a2
BOOT_B=00000000-0000-4000-8000-0000000000b2
BUNDLE_VERSION=0.1.0
