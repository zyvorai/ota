# NOT DEPLOYABLE: fill these values in the exact board's BSP image build.
[system]
compatible=REPLACE_WITH_BOARD_AND_REVISION
bootloader=uboot
data-directory=/var/lib/rauc
activate-installed=true

[keyring]
path=/etc/rauc/trusted-root.pem

[slot.rootfs.0]
device=/dev/disk/by-partuuid/REPLACE_ROOTFS_A
type=ext4
bootname=A

[slot.boot.0]
device=/dev/disk/by-partuuid/REPLACE_BOOT_A
type=vfat
parent=rootfs.0

[slot.rootfs.1]
device=/dev/disk/by-partuuid/REPLACE_ROOTFS_B
type=ext4
bootname=B

[slot.boot.1]
device=/dev/disk/by-partuuid/REPLACE_BOOT_B
type=vfat
parent=rootfs.1
